CONFIG_PATH=

POSTGRES_PORT=5432
GO_DB_NAME=orchestrator
GO_DB_USER=orchestrator
GO_DB_PASSWORD=change-local-go-password


DSN=postgres://${GO_DB_USER}:${GO_DB_PASSWORD}@localhost:${POSTGRES_PORT}/${GO_DB_NAME}?sslmode=disable
S3_ACCESS_KEY=localadmin
S3_SECRET_KEY=change-local-minio-password

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DSN}
